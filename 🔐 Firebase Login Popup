<!-- Firebase Login Popup -->
<div id="firebaseLoginPopup" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;justify-content:center;align-items:center;">
  <div style="background:#fff;padding:20px;border-radius:10px;position:relative;width:300px;box-shadow:0 10px 20px rgba(0,0,0,0.3);">
    <span onclick="hideFirebasePopup()" style="position:absolute;right:10px;top:10px;cursor:pointer;">×</span>
    <h3 style="text-align:center;">Login</h3>
    <input type="email" id="firebaseEmail" placeholder="Email" style="width:100%;padding:8px;margin-bottom:10px;" />
    <input type="password" id="firebasePassword" placeholder="Password" style="width:100%;padding:8px;margin-bottom:10px;" />
    <button onclick="firebaseLogin()" style="width:100%;padding:10px;background:green;color:white;border:none;">Login</button>
    <p style="text-align:center;margin-top:10px;">
      <a href="https://forms.gle/R7AJLdH7Fv5dJmoS9" target="_blank" style="color:blue;cursor:pointer;text-decoration:underline;">Forgot Password?</a>
    </p>
  </div>
</div>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-auth-compat.js"></script>

<script>
  const firebaseConfig = {
    apiKey: "AIzaSyDAzcc9dB95IMT2KN1ZIuUGgGb6CNlHh-w",
    authDomain: "dkonsult-a3231.firebaseapp.com",
    projectId: "dkonsult-a3231",
    storageBucket: "dkonsult-a3231.firebasestorage.app",
    messagingSenderId: "255590780900",
    appId: "1:255590780900:web:bb4d4f522d336f82ee01f1",
    measurementId: "G-Y16RT9BJDS"
  };

  firebase.initializeApp(firebaseConfig);
  const auth = firebase.auth();

  function showFirebasePopup() {
    document.getElementById("firebaseLoginPopup").style.display = "flex";
  }

  function hideFirebasePopup() {
    document.getElementById("firebaseLoginPopup").style.display = "none";
  }

  function firebaseLogin() {
    const email = document.getElementById("firebaseEmail").value;
    const password = document.getElementById("firebasePassword").value;
    auth.signInWithEmailAndPassword(email, password)
      .then(() => {
        window.location.href = "https://www.socialcreator.com/debeatzgh";
      })
      .catch(error => {
        alert(error.message);
      });
  }

  setTimeout(showFirebasePopup, Math.floor(Math.random() * 5000) + 45000);
</script>
